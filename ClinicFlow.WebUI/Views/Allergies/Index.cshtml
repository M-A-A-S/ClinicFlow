@using ClinicFlow.WebUI.ViewModels.Pagination
@using ClinicFlow.WebUI.ViewModels.Allergy;
@model AllergyIndexVM

@{

	var routes = Model.Filter.ToRouteDictionary();

    var pagination = new PaginationVM
    {
        PageNumber = Model.PagedResult.PageNumber,
        PageSize = Model.PagedResult.PageSize,
        TotalPages = Model.PagedResult.TotalPages,
        TotalCount = Model.PagedResult.TotalCount,
        RouteValues = routes

    };
}

<div class="d-flex align-items-center justify-content-between my-4">
    <h2>@Localizer["Allergies"]</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>
        @Localizer["CreateNew"]
    </a>
</div>

<partial name="Partials/_AllergyFilter" />

<partial name="Partials/_Pagination"
         model="pagination" />

<partial name="Partials/_AllergyTable" />

<partial name="Partials/_Pagination"
         model="pagination" />