@using ClinicFlow.Domain.DTOs.Allergy
@using ClinicFlow.WebUI.ViewModels.Allergy;
@using ClinicFlow.WebUI.ViewModels.Common
@model AllergyIndexVM


@{
    var routes = Model.Filter.ToRouteDictionary();

    var columns = new List<TableColumnVM>
    {
        new TableColumnVM 
        { 
            Column = "NameEn", 
            Title = Localizer["NameEn"]
        },
        new TableColumnVM 
        { 
            Column = "NameAr", 
            Title = Localizer["NameAr"] 
        },
        new TableColumnVM 
        { 
            Column = "DescriptionEn", 
            Title = Localizer["DescriptionEn"] 
        },
        new TableColumnVM 
        { 
            Column = "DescriptionAr", 
            Title = Localizer["DescriptionAr"] 
        },
        new TableColumnVM 
        { 
            Column = "IsActive", 
            Title = Localizer["IsActive"],
			IsSortable = false
        },
        new TableColumnVM 
        { 
            Column = string.Empty,
            Title = Localizer["Actions"],
			IsSortable = false
        }
	};

}

@if (!Model.PagedResult.Items.Any())
{
    <div class="alert alert-info">
        @Localizer["NoRecordsFound"]
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    @foreach (var column in columns)
                    {
                        <th>
                            @if (column.IsSortable)
                            {
                                <partial name="Partials/_SortableHeader"
                                         model='new SortHeaderVM
                                         {
                                             Column = column.Column,
                                             Title = column.Title,
                                             Filter = Model.Filter,
                                             Routes = routes
                                         }' />
                            }
                            else
                            {
                                @column.Title
							}
                        </th>
                    }
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.PagedResult.Items)
                {
                    <tr>
                        <td>@item.NameEn</td>

                        <td>@item.NameAr</td>

                        <td>@item.DescriptionEn</td>

                        <td>@item.DescriptionAr</td>

                        <td>@(item.IsActive? Localizer["Active"] : Localizer["Inactive"])</td>

                        <td class="d-flex align-items-center gap-1">
                            <partial name="Partials/_Actions"
                                     model='new ActionButtonsVM
                                     {
                                         Controller = "Allergies",
                                         Id = item.Id
                                     }' />
                </td>
            </tr>
                        }
            </tbody>
        </table>
    </div>
}