@using ClinicFlow.Domain.DTOs.Medicine
@model MedicineDTO


<div class="row g-3 mb-2">

    @* ================= NameEn ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="NameEn" class="form-label"></label>
        <input asp-for="NameEn" class="form-control" />
        <span asp-validation-for="NameEn" class="text-danger"></span>
    </div>

    @* ================= NameAr ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="NameAr" class="form-label"></label>
        <input asp-for="NameAr" class="form-control" />
        <span asp-validation-for="NameAr" class="text-danger"></span>
    </div>

    @* ================= GenericNameEn ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="GenericNameEn" class="form-label"></label>
        <input asp-for="GenericNameEn" class="form-control" />
        <span asp-validation-for="GenericNameEn" class="text-danger"></span>
    </div>

    @* ================= GenericNameAr ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="GenericNameAr" class="form-label"></label>
        <input asp-for="GenericNameAr" class="form-control" />
        <span asp-validation-for="GenericNameAr" class="text-danger"></span>
    </div>

    @* ================= Strength ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="Strength" class="form-label"></label>
        <input asp-for="Strength" class="form-control" />
        <span asp-validation-for="Strength" class="text-danger"></span>
    </div>

    @* ================= DosageForm ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="DosageForm" class="form-label"></label>
        <input asp-for="DosageForm" class="form-control" />
        <span asp-validation-for="DosageForm" class="text-danger"></span>
    </div>

    @* ================= Route ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="Route" class="form-label"></label>
        <input asp-for="Route" class="form-control" />
        <span asp-validation-for="Route" class="text-danger"></span>
    </div>

    @* ================= IsActive ================= *@
    <div class="col-sm-6 col-md-4 d-flex align-items-end">
        <div class="form-check form-switch">
            <input asp-for="IsActive"
                   class="form-check-input"
                   type="checkbox" />

            <label asp-for="IsActive"
                   class="form-check-label"></label>

            <span asp-validation-for="IsActive"
                  class="text-danger"></span>
        </div>
    </div>

</div>
