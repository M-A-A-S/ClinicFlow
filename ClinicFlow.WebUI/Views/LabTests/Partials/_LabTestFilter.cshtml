@using ClinicFlow.WebUI.ViewModels.LabTest;
@model LabTestIndexVM

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            @* ========================== Search ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.Search" class="form-label">@Localizer["Search"]</label>
                <input asp-for="Filter.Search"
                       class="form-control"
                       placeholder="@Localizer["Search"]" />
            </div>

            @* ========================== Category ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.CategoryId" class="form-label">@Localizer["Category"]</label>
                <select asp-for="Filter.CategoryId"
                        id="categoryId"
                        class="form-select select2"
                        asp-items="ViewBag.LabCategories">
                    <option value="">
                        @Localizer["Select"]
                    </option>
                </select>
            </div>

            @* ========================== IsActive ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.IsActive" class="form-label">@Localizer["IsActive"]</label>
                <select asp-for="Filter.IsActive"
                        id="isActiveId"
                        class="form-select select2">
                    <option value="">
                        @Localizer["All"]
                    </option>
                    <option value="true">
                        @Localizer["IsActive"]
                    </option>
                    <option value="false">
                        @Localizer["Inactive"]
                    </option>
                </select>
            </div>

            @* ========================== MinPrice ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.MinPrice" class="form-label">@Localizer["MinPrice"]</label>
                <input asp-for="Filter.MinPrice"
                       class="form-control"
                       placeholder="@Localizer["Search"]" />
            </div>

            @* ========================== MaxPrice ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.MaxPrice" class="form-label">@Localizer["MaxPrice"]</label>
                <input asp-for="Filter.MaxPrice"
                       class="form-control"
                       placeholder="@Localizer["Search"]" />
            </div>

            @* ========================== Actions ========================== *@
            <div class="col-auto">
                <button type="submit"
                        class="btn btn-primary">
                    <i class="fa fa-search me-1"></i>
                    @Localizer["Search"]
                </button>
            </div>

            <div class="col-auto">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fa fa-times me-1"></i>
                    @Localizer["Clear"]
                </a>
            </div>

        </div>
    </div>
</form>