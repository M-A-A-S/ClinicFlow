@using ClinicFlow.Domain.DTOs.LabTest
@model LabTestDTO


<div class="row g-3 mb-2">

    @* ================= NameEn ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="NameEn" class="form-label"></label>
        <input asp-for="NameEn" class="form-control" />
        <span asp-validation-for="NameEn" class="text-danger"></span>
    </div>

    @* ================= NameAr ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="NameAr" class="form-label"></label>
        <input asp-for="NameAr" class="form-control" />
        <span asp-validation-for="NameAr" class="text-danger"></span>
    </div>


    @* ================= Price ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="number" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    @* ================= Category ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId"
                id="categoryId"
                class="form-select select2"
                asp-items="ViewBag.LabCategories">
            <option value="">
                @Localizer["Select"]
            </option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    @* ================= IsActive ================= *@
    <div class="col-sm-6 col-md-4 d-flex align-items-end">
        <div class="form-check form-switch">
            <input asp-for="IsActive"
                   class="form-check-input"
                   type="checkbox" />

            <label asp-for="IsActive"
                   class="form-check-label"></label>

            <span asp-validation-for="IsActive"
                  class="text-danger"></span>
        </div>
    </div>

</div>

<partial name="Partials/_LabTestParameterForm" model="Model" />
