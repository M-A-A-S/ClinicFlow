@using ClinicFlow.Domain.DTOs.LabTest
@model LabTestDTO


<div class="card shadow-sm">

    <div class="card-header">
        <h5>@Localizer["Edit"] @Localizer["LabTest"]</h5>
    </div>

    <div class="card-body">

        <form asp-action="Edit">

            <input type="hidden" asp-for="Id" />

            <partial name="Partials/_LabTestForm" model="Model" />

            <button type="submit" class="btn btn-primary">
                @Localizer["Edit"]
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                @Localizer["Cancel"]
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const activeText = '@Html.Raw(Localizer["Active"])';
        const inactiveText = '@Html.Raw(Localizer["Inactive"])';
        const removeText = '@Html.Raw(Localizer["Remove"])';
    </script>


    <script src="~/js/lab-test-form.js" asp-append-version="true"></script>

}