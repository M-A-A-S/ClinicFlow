@using ClinicFlow.Domain.Enums
@using ClinicFlow.WebUI.ViewModels.Common
@using ClinicFlow.WebUI.ViewModels.Appointment;
@model AppointmentIndexVM

@{
    var routes = Model.Filter.ToRouteDictionary();

    var isArabic = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";

    var columns = new List<TableColumnVM>
    {
        new TableColumnVM
        {
            Column = "AppointmentNumber",
            Title = Localizer["AppointmentNumber"]
        },
        new TableColumnVM
        {
            Column = "PatientId",
            Title = Localizer["Patient"]
        },
        new TableColumnVM
        {
            Column = "ClinicId",
            Title = Localizer["Clinic"]
        },
        new TableColumnVM
        {
            Column = "DoctorId",
            Title = Localizer["Doctor"]
        },
        new TableColumnVM
        {
            Column = "StartAt",
            Title = Localizer["StartAt"]
        },
        new TableColumnVM
        {
            Column = "EndAt",
            Title = Localizer["EndAt"]
        },
        new TableColumnVM
        {
            Column = "Reason",
            Title = Localizer["Reason"],
            IsSortable = false
        },
        new TableColumnVM
        {
            Column = "Notes",
            Title = Localizer["Notes"],
            IsSortable = false
        },
        new TableColumnVM
        {
            Column = "Status",
            Title = Localizer["Status"],
            IsSortable = false
        },
        new TableColumnVM
        {
            Column = string.Empty,
            Title = Localizer["Actions"],
            IsSortable = false
        }
    };

}

@if (!Model.PagedResult.Items.Any())
{
    <div class="alert alert-info">
        @Localizer["NoRecordsFound"]
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    @foreach (var column in columns)
                    {
                        <th>
                            @if (column.IsSortable)
                            {
                                <partial name="Partials/_SortableHeader"
                                         model='new SortHeaderVM
                                         {
                                             Column = column.Column,
                                             Title = column.Title,
                                             Filter = Model.Filter,
                                             Routes = routes
                                         }' />
                                        }
                            else
                            {
                                @column.Title
                            }
                        </th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.PagedResult.Items)
                {
                    <tr>
                        <td>@item.AppointmentNumber</td>

                        <td>@item?.Patient?.FullName</td>

                        <td>@(isArabic? item?.Clinic?.NameAr : item?.Clinic?.NameEn)</td>

                        <td>@item?.Doctor?.FullName</td>

                        <td>@item.StartAt</td>

                        <td>@item.EndAt</td>

                        <td>@item.Reason</td>

                        <td>@item.Notes</td>

                        <td>
                            <span class="badge @item.Status.ToCssClass()">
                                @Localizer[item.Status.ToString()]
                            </span>
                        </td>

                        <td>

                            <div class="d-flex gap-1 align-items-center">

                                @if (!item.WaitingQueueId.HasValue)
                                {
                                    <a asp-controller="WaitingQueues"
                                       asp-action="Create"
                                       asp-route-appointmentId="@item.Id"
                                       class="btn btn-icon btn-outline-info tooltip-btn"
                                       data-tooltip="@Localizer["CheckIn"]">
                                        <i class="fa fa-user-clock me-1"></i>
                                    </a>
                                }
                                else if (!item.VisitId.HasValue)
                                {
                                    <a asp-controller="WaitingQueues"
                                       asp-action="Details"
                                       asp-route-id="@item.WaitingQueueId"
                                       class="btn btn-icon btn-outline-info tooltip-btn"
                                       data-tooltip="@Localizer["ViewQueue"]">
                                        <i class="fa fa-list-ol me-1"></i>
                                    </a>

                                    <a asp-controller="Visits"
                                       asp-action="Create"
                                       asp-route-waitingQueueId="@item.WaitingQueueId"
                                       class="btn btn-icon btn-outline-info tooltip-btn"
                                       data-tooltip="@Localizer["StartVisit"]">
                                        <i class="fa fa-stethoscope me-1"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Visits"
                                       asp-action="Details"
                                       asp-route-id="@item.VisitId"
                                       class="btn btn-icon btn-outline-info tooltip-btn"
                                       data-tooltip="@Localizer["ViewVisit"]">
                                        <i class="fa fa-eye me-1"></i>
                                    </a>
                                }

                                <partial name="Partials/_Actions"
                                         model='new ActionButtonsVM
                                         {
                                             Controller = "Appointments",
                                             Id = item.Id
                                         }' />

                                        
                            </div>
                </td>

            </tr>
                        }
            </tbody>
        </table>
    </div>
}
