@using ClinicFlow.Domain.Enums
@using ClinicFlow.WebUI.ViewModels.Bond;
@model BondIndexVM

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            @* ========================== Search ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.Search" class="form-label">@Localizer["Search"]</label>
                <input asp-for="Filter.Search"
                       class="form-control"
                       placeholder="@Localizer["Search"]" />
            </div>

            @* ========================== Type ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.Type" class="form-label">@Localizer["Type"]</label>
                <select asp-for="Filter.Type"
                        id="typeId"
                        class="form-select select2"
                        asp-items="Html.GetEnumSelectList<BondType>()">
                    <option value="">
                        @Localizer["All"]
                    </option>
                </select>
            </div>

            @* ========================== PartyType ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.Party" class="form-label">@Localizer["PartyType"]</label>
                <select asp-for="Filter.Party"
                        id="partyTypeId"
                        class="form-select select2"
                        asp-items="Html.GetEnumSelectList<PartyType>()">
                    <option value="">
                        @Localizer["All"]
                    </option>
                </select>
            </div>

            @* ========================== Category ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.CategoryId" class="form-label">@Localizer["Category"]</label>
                <select asp-for="Filter.CategoryId"
                        id="categoryId"
                        class="form-select select2"
                        asp-items="ViewBag.BondCategories">
                    <option value="">
                        @Localizer["All"]
                    </option>
                </select>
            </div>

            @* ========================== PaymentMethod ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.PaymentMethodId" class="form-label">@Localizer["PaymentMethod"]</label>
                <select asp-for="Filter.PaymentMethodId"
                        id="paymentMethodId"
                        class="form-select select2"
                        asp-items="ViewBag.PaymentMethods">
                    <option value="">
                        @Localizer["All"]
                    </option>
                </select>
            </div>

            @* ========================== FromDate ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.FromDate" class="form-label">@Localizer["FromDate"]</label>
                <input asp-for="Filter.FromDate"
                       class="form-control"
                       type="date"
                       placeholder="@Localizer["FromDate"]" />
            </div>

            @* ========================== ToDate ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.ToDate" class="form-label">@Localizer["ToDate"]</label>
                <input asp-for="Filter.ToDate"
                       class="form-control"
                       type="date"
                       placeholder="@Localizer["ToDate"]" />
            </div>

            @* ========================== MinAmount ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.MinAmount" class="form-label">@Localizer["MinAmount"]</label>
                <input asp-for="Filter.MinAmount"
                       type="number"
                       class="form-control"
                       placeholder="@Localizer["MinAmount"]" />
            </div>

            @* ========================== MaxAmount ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.MaxAmount" class="form-label">@Localizer["MaxAmount"]</label>
                <input asp-for="Filter.MaxAmount"
                        type="number"
                       class="form-control"
                       placeholder="@Localizer["MaxAmount"]" />
            </div>

            @* ========================== Actions ========================== *@
            <div class="col-auto">
                <button type="submit"
                        class="btn btn-primary">
                    <i class="fa fa-search me-1"></i>
                    @Localizer["Search"]
                </button>
            </div>

            <div class="col-auto">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fa fa-times me-1"></i>
                    @Localizer["Clear"]
                </a>
            </div>

        </div>
    </div>
</form>