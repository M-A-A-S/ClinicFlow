@using ClinicFlow.Domain.DTOs.Patient
@using ClinicFlow.Domain.Enums
@model PatientDTO

@{
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}


<div class="row g-3 mb-2">

    @* ================= FullName ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    @* ================= PhoneNumber ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    @* ================= Email ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    @* ================= Gender ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="Gender" class="form-label"></label>
        <select asp-for="Gender"
                asp-items="Html.GetEnumSelectList<Gender>()"
                class="form-select">
        </select>
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>

    @* ================= NationalId ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="NationalId" class="form-label"></label>
        <input asp-for="NationalId" class="form-control" />
        <span asp-validation-for="NationalId" class="text-danger"></span>
    </div>

    @* ================= Address ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    @* ================= DateOfBirth ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" type="date" class="form-control" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>

    @* ================= BloodType ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="BloodType" class="form-label"></label>
        <select asp-for="Gender"
                asp-items="Html.GetEnumSelectList<BloodType>()"
                class="form-select">
        </select>
        <span asp-validation-for="BloodType" class="text-danger"></span>
    </div>

    @* ================= IsActive ================= *@
    <div class="col-sm-6 col-md-4 d-flex align-items-end">
        <div class="form-check form-switch">
            <input asp-for="IsActive"
                   class="form-check-input"
                   type="checkbox" />

            <label asp-for="IsActive"
                   class="form-check-label"></label>

            <span asp-validation-for="IsActive"
                  class="text-danger"></span>
        </div>
    </div>

</div>

<!-- ========================================================= -->
<!-- Allergies                                                 -->
<!-- ========================================================= -->

<div class="card mt-4">

    <div class="card-header">

        <h5 class="mb-0">
            @Localizer["Allergies"]
        </h5>

    </div>


    <div class="card-body">

        <!-- Add Allergy -->
        <div class="row g-3 align-items-end">

            <div class="col-md-4">

                <label class="form-label">
                    @Localizer["Allergy"]
                </label>

                <select id="allergyId"
                        class="form-select"
                        asp-items="ViewBag.Allergies">

                    <option value="">
                        @Localizer["Select"]
                    </option>

                </select>

            </div>


            <div class="col-md-3">

                <label class="form-label">
                    @Localizer["Notes"]
                </label>

                <input id="allergyNotes"
                       type="text"
                       class="form-control" />

            </div>


            <div class="col-md-3">

                <label class="form-label">
                    @Localizer["IdentifiedAt"]
                </label>

                <input id="allergyIdentifiedAt"
                       type="date"
                       class="form-control"
                       value="@today" />

            </div>


            <div class="col-md-2">

                <button type="button"
                        id="add-allergy"
                        class="btn btn-primary w-100">

                    <i class="fa fa-plus"></i>

                    @Localizer["Add"]

                </button>

            </div>

        </div>


        <!-- Allergy Table -->
        <div class="table-responsive mt-4">

            <table class="table">

                <thead>

                    <tr>

                        <th>
                            @Localizer["Allergy"]
                        </th>

                        <th>
                            @Localizer["Notes"]
                        </th>

                        <th>
                            @Localizer["IdentifiedAt"]
                        </th>

                        <th style="width: 80px;">
                        </th>

                    </tr>

                </thead>


                <tbody id="allergies-container">

                    @* JavaScript adds rows here *@

                </tbody>

            </table>

        </div>

    </div>

</div>



