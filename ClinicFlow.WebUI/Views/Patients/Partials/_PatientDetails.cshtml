                    <thead>
                        <tr>
                            <th>
                                @Localizer["ChronicCondition"]
                            </th>
                            <th>
                                @Localizer["Notes"]
                            </th>
                            <th>
                                @Localizer["DiagnosedAt"]
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.PatientChronicConditions)
                        {
                            <tr>

                                <td>
                            @if (item.ChronicCondition != null)
                                    {
                                        @(isArabic
                                                                    ? item.ChronicCondition.NameAr
                                                                    : item.ChronicCondition.NameEn)

                                                        }
                                    else
                                    {
                                        @:-
                                    }
                            </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Notes)
                                                                ? "-"
                                                                : item.Notes)
                                                                         </td>

                                <td>
                                    @(item.DiagnosedAt.HasValue
                                                                ? item.DiagnosedAt.Value.ToString("yyyy-MM-dd")
                                                                : "-")
