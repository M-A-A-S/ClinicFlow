@using ClinicFlow.Domain.DTOs.Visit
@model VisitDTO

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-transparent border-bottom py-3">

        <h5 class="mb-0 fw-semibold">

            <i class="fa fa-notes-medical me-2"></i>

            @Localizer["Diagnoses"]

        </h5>

    </div>

    <div class="card-body">

        <div class="row g-3 align-items-end">

            <div class="col-md-6 col-lg-5">

                <label class="form-label fw-medium">
                    @Localizer["Diagnosis"]
                </label>

                <select id="diagnosisId"
                        class="form-select select2"
                        asp-items="ViewBag.Diagnosis">

                    <option value="">
                        @Localizer["Select"]
                    </option>

                </select>

            </div>


            <div class="col-md-4 col-lg-5">

                <label class="form-label fw-medium">
                    @Localizer["Notes"]
                </label>

                <input id="diagnosisNotes"
                       type="text"
                       class="form-control"
                       maxlength="500" />

            </div>


            <div class="col-md-2">

                <button type="button"
                        id="add-diagnosis"
                        class="btn btn-primary w-100">

                    <i class="fa fa-plus me-1"></i>

                    @Localizer["Add"]

                </button>

            </div>

        </div>


        <div class="table-responsive mt-4">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>
                            @Localizer["Diagnosis"]
                        </th>

                        <th>
                            @Localizer["Notes"]
                        </th>

                        <th class="text-center"
                            style="width:80px;">
                        </th>

                    </tr>

                </thead>

                <tbody id="diagnoses-container">

                    @if (Model.VisitDiagnoses != null)
                    {
                        for (var i = 0;
                        i < Model.VisitDiagnoses.Count;
                        i++)
                        {
                            var diagnosis =
                            Model.VisitDiagnoses[i];

                            <tr class="visit-diagnosis-row"
                                data-diagnosis-id="@diagnosis.DiagnosisId">

                                <td>

                                    @diagnosis.Diagnosis?.NameEn

                                    <input type="hidden"
                                           name="VisitDiagnoses.Index"
                                           value="@i" />

                                    <input type="hidden"
                                           name="VisitDiagnoses[@i].Id"
                                           value="@diagnosis.Id" />

                                    <input type="hidden"
                                           name="VisitDiagnoses[@i].DiagnosisId"
                                           value="@diagnosis.DiagnosisId" />

                                </td>

                                <td>

                                    @diagnosis.Notes

                                    <input type="hidden"
                                           name="VisitDiagnoses[@i].Notes"
                                           value="@diagnosis.Notes" />

                                </td>

                                <td class="text-center">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger remove-diagnosis">

                                        <i class="fa fa-trash"></i>

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>


            <div id="diagnosis-empty"
                 class="text-center text-muted py-4">

                <i class="fa fa-notes-medical fa-2x mb-2"></i>

                <div>
                    @Localizer["NoDiagnosesAdded"]
                </div>

            </div>

        </div>

    </div>

</div>