<div class="container-fluid px-0">

    <ul class="nav nav-tabs" id="visitDetailsTabs" role="tablist">

        <!-- Visit Information -->
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="visit-information-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#visitInformationTab"
                    type="button"
                    role="tab"
                    aria-controls="visitInformationTab"
                    aria-selected="true">
                <i class="fa fa-info-circle me-1"></i>
                @Localizer["VisitInformation"]
            </button>
        </li>

        <!-- Vital Signs -->
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="vital-signs-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#vitalSignsTab"
                    type="button"
                    role="tab"
                    aria-controls="vitalSignsTab"
                    aria-selected="false">
                <i class="fa fa-heartbeat me-1"></i>
                @Localizer["VitalSigns"]
            </button>
        </li>

        <!-- Diagnoses -->
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="diagnoses-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#diagnosesTab"
                    type="button"
                    role="tab"
                    aria-controls="diagnosesTab"
                    aria-selected="false">
                <i class="fa fa-stethoscope me-1"></i>
                @Localizer["Diagnoses"]
            </button>
        </li>

        <!-- Prescription -->
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="prescription-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#prescriptionTab"
                    type="button"
                    role="tab"
                    aria-controls="prescriptionTab"
                    aria-selected="false">
                <i class="fa fa-prescription-bottle me-1"></i>
                @Localizer["Prescription"]
            </button>
        </li>

    </ul>


    <div class="tab-content border border-top-0 rounded-bottom p-4"
         id="visitDetailsTabsContent">

        <!-- Visit Information -->
        <div class="tab-pane fade show active"
             id="visitInformationTab"
             role="tabpanel"
             aria-labelledby="visit-information-tab">

            <partial name="Partials/_VisitInformationDetails"
                     model="Model" />

        </div>


        <!-- Vital Signs -->
        <div class="tab-pane fade"
             id="vitalSignsTab"
             role="tabpanel"
             aria-labelledby="vital-signs-tab">

            <partial name="Partials/_VisitVitalSignsDetails"
                     model="Model" />

        </div>


        <!-- Diagnoses -->
        <div class="tab-pane fade"
             id="diagnosesTab"
             role="tabpanel"
             aria-labelledby="diagnoses-tab">

            <partial name="Partials/_VisitDiagnosesDetails"
                     model="Model" />

        </div>


        <!-- Prescription -->
        <div class="tab-pane fade"
             id="prescriptionTab"
             role="tabpanel"
             aria-labelledby="prescription-tab">

            <partial name="Partials/_VisitPrescriptionDetails"
                     model="Model" />

        </div>

    </div>

</div>