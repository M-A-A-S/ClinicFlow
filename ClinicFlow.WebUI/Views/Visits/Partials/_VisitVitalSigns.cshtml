@using ClinicFlow.Domain.DTOs.Visit

@model VisitDTO

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-transparent border-bottom py-3">

        <h5 class="mb-0 fw-semibold">

            <i class="fa fa-heartbeat me-2"></i>

            @Localizer["VitalSigns"]

        </h5>

    </div>

    <div class="card-body">

        <div class="row g-3">

            <!-- Temperature -->

            <div class="col-sm-6 col-md-4 col-xl-3">

                <label asp-for="VitalSign.Temperature"
                       class="form-label">
                </label>

                <div class="input-group">

                    <input asp-for="VitalSign.Temperature"
                           class="form-control"
                           type="number"
                           min="0" />

                    <span class="input-group-text">
                        °C
                    </span>

                </div>

                <span asp-validation-for="VitalSign.Temperature"
                      class="text-danger small">
                </span>

            </div>


            <!-- Pulse -->

            <div class="col-sm-6 col-md-4 col-xl-3">

                <label asp-for="VitalSign.Pulse"
                       class="form-label">
                </label>

                <div class="input-group">

                    <input asp-for="VitalSign.Pulse"
                           class="form-control"
                           type="number"
                           min="0" />

                    <span class="input-group-text">
                        bpm
                    </span>

                </div>

                <span asp-validation-for="VitalSign.Pulse"
                      class="text-danger small">
                </span>

            </div>


            <!-- Systolic -->

            <div class="col-sm-6 col-md-4 col-xl-3">

                <label asp-for="VitalSign.SystolicBloodPressure"
                       class="form-label">
                </label>

                <div class="input-group">

                    <input asp-for="VitalSign.SystolicBloodPressure"
                           class="form-control"
                           type="number"
                           min="0" />

                    <span class="input-group-text">
                        mmHg
                    </span>

                </div>

                <span asp-validation-for="VitalSign.SystolicBloodPressure"
                      class="text-danger small">
                </span>

            </div>


            <!-- Diastolic -->

            <div class="col-sm-6 col-md-4 col-xl-3">

                <label asp-for="VitalSign.DiastolicBloodPressure"
                       class="form-label">
                </label>

                <div class="input-group">

                    <input asp-for="VitalSign.DiastolicBloodPressure"
                           class="form-control"
                           type="number"
                           min="0" />

                    <span class="input-group-text">
                        mmHg
                    </span>

                </div>

                <span asp-validation-for="VitalSign.DiastolicBloodPressure"
                      class="text-danger small">
                </span>

            </div>


            <!-- Respiratory Rate -->

            <div class="col-sm-6 col-md-4 col-xl-3">

                <label asp-for="VitalSign.RespiratoryRate"
                       class="form-label">
                </label>

                <div class="input-group">

                    <input asp-for="VitalSign.RespiratoryRate"
                           class="form-control"
                           type="number"
                           min="0" />

                    <span class="input-group-text">
                        /min
                    </span>

                </div>

                <span asp-validation-for="VitalSign.RespiratoryRate"
                      class="text-danger small">
                </span>

            </div>


            <!-- Oxygen -->

            <div class="col-sm-6 col-md-4 col-xl-3">

                <label asp-for="VitalSign.OxygenSaturation"
                       class="form-label">
                </label>

                <div class="input-group">

                    <input asp-for="VitalSign.OxygenSaturation"
                           class="form-control"
                           type="number"
                           min="0"
                           max="100" />

                    <span class="input-group-text">
                        %
                    </span>

                </div>

                <span asp-validation-for="VitalSign.OxygenSaturation"
                      class="text-danger small">
                </span>

            </div>


            <!-- Weight -->

            <div class="col-sm-6 col-md-4 col-xl-3">

                <label asp-for="VitalSign.Weight"
                       class="form-label">
                </label>

                <div class="input-group">

                    <input asp-for="VitalSign.Weight"
                           id="weight"
                           class="form-control"
                           type="number"
                           min="0" />

                    <span class="input-group-text">
                        kg
                    </span>

                </div>

                <span asp-validation-for="VitalSign.Weight"
                      class="text-danger small">
                </span>

            </div>


            <!-- Height -->

            <div class="col-sm-6 col-md-4 col-xl-3">

                <label asp-for="VitalSign.Height"
                       class="form-label">
                </label>

                <div class="input-group">

                    <input asp-for="VitalSign.Height"
                           id="height"
                           class="form-control"
                           type="number"
                           min="0" />

                    <span class="input-group-text">
                        cm
                    </span>

                </div>

                <span asp-validation-for="VitalSign.Height"
                      class="text-danger small">
                </span>

            </div>


            <!-- BMI -->

            <div class="col-sm-6 col-md-4 col-xl-3">

                <label class="form-label">
                    @Localizer["BMI"]
                </label>

                <div class="input-group">

                    <input id="bmi"
                           class="form-control"
                           type="text"
                           readonly />

                    <span class="input-group-text">
                        kg/m²
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>