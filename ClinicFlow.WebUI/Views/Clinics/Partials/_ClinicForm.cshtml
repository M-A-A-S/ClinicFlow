@using ClinicFlow.Domain.DTOs.Clinic
@model ClinicDTO


<div class="row g-3 mb-2">

    @* ================= NameEn ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="NameEn" class="form-label"></label>
        <input asp-for="NameEn" class="form-control" />
        <span asp-validation-for="NameEn" class="text-danger"></span>
    </div>

    @* ================= NameAr ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="NameAr" class="form-label"></label>
        <input asp-for="NameAr" class="form-control" />
        <span asp-validation-for="NameAr" class="text-danger"></span>
    </div>

    @* ================= DescriptionEn ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="DescriptionEn" class="form-label"></label>
        <input asp-for="DescriptionEn" class="form-control" />
        <span asp-validation-for="DescriptionEn" class="text-danger"></span>
    </div>

    @* ================= DescriptionAr ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="DescriptionAr" class="form-label"></label>
        <input asp-for="DescriptionAr" class="form-control" />
        <span asp-validation-for="DescriptionAr" class="text-danger"></span>
    </div>

    @* ================= IsActive ================= *@
    <div class="col-sm-6 col-md-4 d-flex align-items-end">
        <div class="form-check form-switch">
            <input asp-for="IsActive"
                   class="form-check-input"
                   type="checkbox" />

            <label asp-for="IsActive"
                   class="form-check-label"></label>

            <span asp-validation-for="IsActive"
                  class="text-danger"></span>
        </div>
    </div>

</div>

<!-- ========================================================= -->
<!-- Doctors                                                 -->
<!-- ========================================================= -->

<div class="card mt-4 mb-2">

    <div class="card-header">

        <h5 class="mb-0">
            @Localizer["Doctors"]
        </h5>

    </div>


    <div class="card-body">

        <!-- Add Doctor -->
        <div class="row g-3 align-items-end">

            <div class="col-md-6 col-lg-5">

                <label class="form-label">
                    @Localizer["Doctor"]
                </label>

                <select id="doctorId"
                        class="form-select"
                        asp-items="ViewBag.Doctors">

                    <option value="">
                        @Localizer["Select"]
                    </option>

                </select>

            </div>

            <div class="col-md-3 col-lg-2">

                <button type="button"
                        id="add-doctor"
                        class="btn btn-primary w-100">

                    <i class="fa fa-plus"></i>

                    @Localizer["Add"]

                </button>

            </div>

        </div>


        <!-- Doctors Table -->
        <div class="table-responsive mt-4">

            <table class="table">

                <thead>

                    <tr>

                        <th>
                            @Localizer["Doctor"]
                        </th>

                        <th style="width: 80px;">
                        </th>

                    </tr>

                </thead>


                <tbody id="doctors-container">

                    @* JavaScript adds rows here *@

                </tbody>

            </table>

        </div>

    </div>

</div>

