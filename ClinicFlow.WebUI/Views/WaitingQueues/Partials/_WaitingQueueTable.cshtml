@using ClinicFlow.Domain.Enums
@using ClinicFlow.WebUI.ViewModels.Common
@using ClinicFlow.WebUI.ViewModels.WaitingQueue;
@model WaitingQueueIndexVM

@{
    var routes = Model.Filter.ToRouteDictionary();

    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

    var columns = new List<TableColumnVM>
    {
        new TableColumnVM
        {
            Column = "WaitingQueueNumber",
            Title = Localizer["QueueNumber"]
        },
        new TableColumnVM
        {
            Column = "PatientId",
            Title = Localizer["Patient"]
        },
        new TableColumnVM
        {
            Column = "ClinicId",
            Title = Localizer["Clinic"]
        },
        new TableColumnVM
        {
            Column = "DoctorId",
            Title = Localizer["Doctor"]
        },
        new TableColumnVM
        {
            Column = "WaitingQueueDate",
            Title = Localizer["QueueDate"],
            IsSortable = false
        },
        new TableColumnVM
        {
            Column = "JoinedAt",
            Title = Localizer["JoinedAt"]
        },
        new TableColumnVM
        {
            Column = "CalledAt",
            Title = Localizer["CalledAt"]
        },
        new TableColumnVM
        {
            Column = "ServiceStartAt",
            Title = Localizer["ServiceStartAt"]
        },
        new TableColumnVM
        {
            Column = "CompletedAt",
            Title = Localizer["CompletedAt"]
        },
        new TableColumnVM
        {
            Column = "Status",
            Title = Localizer["Status"],
            IsSortable = false
        },
        new TableColumnVM
        {
            Column = "Priority",
            Title = Localizer["Priority"],
            IsSortable = false
        },
        new TableColumnVM
        {
            Column = "Invoice",
            Title = Localizer["Invoice"],
            IsSortable = false
        },
        new TableColumnVM
        {
            Column = "InvoiceStatus",
            Title = Localizer["InvoiceStatus"],
            IsSortable = false
        },
        new TableColumnVM
        {
            Column = string.Empty,
            Title = Localizer["Actions"],
            IsSortable = false
        }
    };

}

@if (!Model.PagedResult.Items.Any())
{
    <div class="alert alert-info">
        @Localizer["NoRecordsFound"]
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    @foreach (var column in columns)
                    {
                        <th>
                            @if (column.IsSortable)
                            {
                                <partial name="Partials/_SortableHeader"
                                         model='new SortHeaderVM
                                         {
                                             Column = column.Column,
                                             Title = column.Title,
                                             Filter = Model.Filter,
                                             Routes = routes
                                         }' />
                                        }
                            else
                            {
                                @column.Title
                            }
                        </th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.PagedResult.Items)
                {
                    <tr>
                        <td>@item.WaitingQueueNumber</td>

                        <td>@item?.Patient?.FullName</td>

                        <td>@(isArabic? item?.Clinic?.NameAr : item?.Clinic?.NameEn)</td>

                        <td>@item?.Doctor?.FullName</td>

                        <td>@item.WaitingQueueDate</td>

                        <td>@item.JoinedAt</td>

                        <td>@item.CalledAt</td>

                        <td>@item.ServiceStartAt</td>

                        <td>@item.CompletedAt</td>

                        <td>
                            <span class="badge @item.Status.ToCssClass()">
                                @Localizer[item.Status.ToString()]
                            </span>
                        </td>

                        <td>
                            <span class="badge @item.Priority.ToCssClass()">
                                @Localizer[item.Priority.ToString()]
                            </span>
                        </td>

                        <td>
                            @if (item.InvoiceId == null)
                            {
                                @* <a asp-controller="Invoices"
                                   asp-action="Create"
                                   asp-route-waitingQueueId="@item.Id"
                                   class="btn btn-icon btn-outline-primary tooltip-btn"
                                   data-tooltip="@Localizer["CreateInvoice"]">
                                    <i class="fa fa-file-invoice me-1"></i>
                                </a> *@
                                <a asp-controller="Invoices"
                                   asp-action="Create"
                                   asp-route-waitingQueueId="@item.Id"
                                   class="btn btn-sm btn-outline-primary text-nowrap">

                                    <i class="fa fa-file-invoice me-1"></i>
                                    @Localizer["CreateInvoice"]

                                </a>
                            }
                            else
                            {
                                <a asp-controller="Invoices"
                                   asp-action="Details"
                                   asp-route-id="@item.InvoiceId"
                                   class="btn btn-sm btn-outline-secondary text-nowrap">

                                    <i class="fa fa-receipt me-1"></i>
                                    @Localizer["ViewInvoice"]

                                </a>
                            }
                        </td>

                        <td>
                            @if (!item.InvoiceId.HasValue)
                            {
                                <span class="badge bg-secondary">
                                    @Localizer["NoInvoice"]
                                </span>
                            }
                            else
                            {
                                <span class="badge @item.Invoice?.Status.ToCssClass()">
                                    @Localizer[item?.Invoice?.Status.ToString() ?? ""]
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex gap-1 align-items-center">
                                <partial name="Partials/_Actions"
                                         model='new ActionButtonsVM
                                         {
                                             Controller = "WaitingQueues",
                                             ShowDelete = !item.InvoiceId.HasValue,
                                             ShowEdit = !item.InvoiceId.HasValue,
                                             Id = item.Id
                                         }' />
                            </div>
                            
                </td>
            </tr>
                        }
            </tbody>
        </table>
    </div>
}
