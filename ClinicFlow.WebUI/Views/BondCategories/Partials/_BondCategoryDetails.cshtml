@using ClinicFlow.Domain.DTOs.BondCategory
@model BondCategoryDTO


<div class="row">

    @* ================= NameEn ================= *@
    <div class="col-sm-6 col-md-4">
        <div class="fw-bold">@Localizer["NameEn"]</div>
        <div>@Model.NameEn</div>
    </div>

    @* ================= NameAr ================= *@
    <div class="col-sm-6 col-md-4">
        <div class="fw-bold">@Localizer["NameAr"]</div>
        <div>@Model.NameAr</div>
    </div>

    @* ================= Type ================= *@
    <div class="col-sm-6 col-md-4">
        <div class="fw-bold">@Localizer["Type"]</div>
        <div>
            <span>
                @Localizer[Model.Type.ToString()]
            </span>
        </div>
    </div>

    @* ================= IsActive ================= *@
    <div class="col-sm-6 col-md-4">
        <div class="fw-bold">@Localizer["IsActive"]</div>
        <div>
            @if (Model.IsActive)
            {
                <span class="badge bg-success">
                    @Localizer["Active"]
                </span>
            }
            else
            {
                <span class="badge bg-danger">
                    @Localizer["Inactive"]
                </span>
            }
        </div>
    </div>
</div>


