@using ClinicFlow.Domain.DTOs.Invoice
@model InvoiceDTO


<div class="mt-4">
    <h5 class="mb-3">
        <i class="fa fa-file-invoice me-2"></i>
        @Localizer["InvoiceItems"]
    </h5>

    <div class="table-responsive mt-4">

        <table class="table table-hover align-middle mb-0">

            <thead>
                <tr>
                    <th>
                        @Localizer["ItemType"]
                    </th>
                    <th>
                        @Localizer["Description"]
                    </th>
                    <th>
                        @Localizer["Quantity"]
                    </th>
                    <th>
                        @Localizer["UnitPrice"]
                    </th>
                    <th>
                        @Localizer["Total"]
                    </th>

                </tr>

            </thead>


            <tbody id="items-container">

                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="invoice-item-row">

                            @* ================= Item Type ================= *@
                            <td>

                                <span>
                                    @Localizer[item.ItemType.ToString()]
                                </span>

                            </td>


                            @* ================= Description ================= *@
                            <td>

                                <span>
                                    @item.Description
                                </span>

                            </td>


                            @* ================= Quantity ================= *@
                            <td>

                                <span>
                                    @item.Quantity
                                </span>

                            </td>


                            @* ================= UnitPrice ================= *@
                            <td>

                                <span>
                                    @item.UnitPrice
                                </span>

                            </td>


                            @* ================= Total ================= *@
                            <td>

                                <span>
                                    @item.Total
                                </span>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>


        @* ================= Empty State ================= *@

        <div id="items-empty"
             class="text-center text-muted py-4 @(Model.Items != null && Model.Items.Any() ? "d-none" : "")">

            <i class="fa fa-notes-medical fa-2x mb-2"></i>

            <div>
                @Localizer["NoItemsFound"]
            </div>

        </div>

    </div>
</div>



