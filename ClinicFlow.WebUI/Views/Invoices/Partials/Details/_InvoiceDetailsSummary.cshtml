@using ClinicFlow.Domain.DTOs.Invoice
@model InvoiceDTO


<div class="mt-4">
    <h5 class="mb-3">
        <i class="fa fa-calculator me-2"></i>
        @Localizer["Summary"]
    </h5>

    <div class="d-flex justify-content-end">

        <div class="border rounded p-3"
             style="min-width: 320px;">

            @* ================= Subtotal ================= *@
            <div class="d-flex justify-content-between mb-2">

                <span>
                    @Localizer["Subtotal"]
                </span>

                <strong>
                    @Model.Subtotal.ToString("N2")
                </strong>

            </div>


            @* ================= Discount ================= *@
            <div class="d-flex justify-content-between mb-2">

                <span>
                    @Localizer["DiscountAmount"]
                </span>

                <strong>
                    @Model.DiscountAmount.ToString("N2")
                </strong>

            </div>


            @* ================= Tax ================= *@
            <div class="d-flex justify-content-between mb-2">

                <span>
                    @Localizer["TaxAmount"]
                </span>

                <strong>
                    @Model.TaxAmount.ToString("N2")
                </strong>

            </div>


            <hr />


            @* ================= Grand Total ================= *@
            <div class="d-flex justify-content-between mb-2">

                <strong>
                    @Localizer["GrandTotal"]
                </strong>

                <strong>
                    @Model.GrandTotal.ToString("N2")
                </strong>

            </div>


            @* ================= Paid Amount ================= *@
            <div class="d-flex justify-content-between mb-2">

                <span>
                    @Localizer["PaidAmount"]
                </span>

                <strong class="text-success">
                    @Model.PaidAmount.ToString("N2")
                </strong>

            </div>


            @* ================= Remaining Amount ================= *@
            <div class="d-flex justify-content-between">

                <strong>
                    @Localizer["RemainingAmount"]
                </strong>

                <strong class="@(Model.RemainingAmount > 0
                                        ? "text-danger"
                                        : "text-success")">

                    @Model.RemainingAmount.ToString("N2")

                </strong>

            </div>

        </div>

    </div>

</div>

