@using ClinicFlow.Domain.DTOs.Invoice
@using System.Globalization
@using ClinicFlow.Domain.Enums
@model InvoiceDTO

@{
    bool isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="d-flex justify-content-end">
    <button type="button"
            id="open-add-payment-modal-btn"
            class="btn btn-primary btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#invoicePaymentModal">

        <i class="fa fa-plus me-1"></i>
        @Localizer["Add"] @Localizer["InvoicePayment"]

    </button>
</div>

<div class="table-responsive mt-4">

    <table class="table table-hover align-middle mb-0">

        <thead>

            <tr>

                <th>
                    @Localizer["Type"]
                </th>

                <th>
                    @Localizer["Amount"]
                </th>

                <th>
                    @Localizer["PaymentMethod"]
                </th>

                <th>
                    @Localizer["PaymentDate"]
                </th>

                <th>
                    @Localizer["Notes"]
                </th>

                <th>
                    @Localizer["ReferenceNumber"]
                </th>

                <th class="text-center"
                    style="width:80px;">
                </th>

            </tr>

        </thead>


        <tbody id="payments-container">

            @if (Model.Payments != null && Model.Payments.Any())
            {
                for (var i = 0; i < Model.Payments.Count; i++)
                {
                    var item = Model.Payments[i];

                    <tr class="invoice-payment-row"
                        data-item-id="@item.Id">

                        @* ================= Type ================= *@
                        <td>

                            <span class="payment-type-text">
                                @Localizer[item.Type.ToString()]
                            </span>

                            <input type="hidden"
                                   name="Payments.Index"
                                   value="@i" />

                            <input type="hidden"
                                   class="payment-id-input"
                                   name="Payments[@i].Id"
                                   value="@item.Id" />

                            <input type="hidden"
                                   class="payment-type-input"
                                   name="Payments[@i].Type"
                                   value="@item.Type" />

                        </td>


                        @* ================= Amount ================= *@
                        <td>
                            <span>
                                @item.Amount
                            </span>

                            <input type="hidden"
                                   class="payment-amount-input"
                                   name="Payments[@i].Amount"
                                   value="@item.Amount" />
                        </td>


                        @* ================= PaymentMethod ================= *@
                        <td>
                            <span>
                                @item.PaymentMethod
                            </span>

                            <input type="hidden"
                                   class="payment-method-input"
                                   name="Payments[@i].PaymentMethod"
                                   value="@item.PaymentMethod" />
                        </td>


                        @* ================= PaymentDate ================= *@
                        <td>
                            <span>
                                @item.PaymentDate
                            </span>

                            <input type="hidden"
                                   class="payment-date-input"
                                   name="Payments[@i].PaymentDate"
                                   value="@item.PaymentDate" />
                        </td>


                        @* ================= ReferenceNumber ================= *@
                        <td>
                            <span>
                                @item.ReferenceNumber
                            </span>

                            <input type="hidden"
                                   class="payment-reference-input"
                                   name="Payments[@i].ReferenceNumber"
                                   value="@item.ReferenceNumber" />
                        </td>

                        @* ================= Notes ================= *@
                        <td>
                            <span>
                                @item.Notes
                            </span>

                            <input type="hidden"
                                   class="payment-notes-input"
                                   name="Payments[@i].Notes"
                                   value="@item.Notes" />
                        </td>

                      


                        @* ================= Remove ================= *@
                        <td class="text-center">

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger remove-payment"
                                    title="@Localizer["Remove"]">

                                <i class="fa fa-trash"></i>

                            </button>

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>


    @* ================= Empty State ================= *@

    <div id="payments-empty"
         class="text-center text-muted py-4 @(Model.Items != null && Model.Items.Any() ? "d-none" : "")">

        <i class="fa fa-notes-medical fa-2x mb-2"></i>

        <div>
            @Localizer["NoItemsFound"]
        </div>

    </div>

</div>