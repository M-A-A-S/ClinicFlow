@using ClinicFlow.Domain.DTOs.Invoice
@using ClinicFlow.Domain.Enums
@model InvoiceDTO


<div class="row g-3 mb-2">

    @* ================= Source IDs ================= *@
    @if (Model.WaitingQueueId.HasValue)
    {
        <input type="hidden" asp-for="WaitingQueueId" />
    }

    @if (Model.AppointmentId.HasValue)
    {
        <input type="hidden" asp-for="AppointmentId" />
    }

    @if (Model.VisitId.HasValue)
    {
        <input type="hidden" asp-for="VisitId" />
    }

    @if (Model.LabOrderId.HasValue)
    {
        <input type="hidden" asp-for="LabOrderId" />
    }


    @* ================= Patient ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="PatientId" class="form-label"></label>
        @if (Model.HasSource)
        {
            <input type="hidden" asp-for="PatientId" />

            <input type="text"
                class="form-control"
                value="@Model.Patient?.FullName"
                readonly/>
        }
        else
        {
            <select asp-for="PatientId"
                    id="patientId"
                    class="form-select select2"
                    asp-items="ViewBag.Patients">
                <option value="">
                    @Localizer["Select"]
                </option>
            </select>
        }
        
        <span asp-validation-for="PatientId" class="text-danger"></span>
    </div>

    @* ================= Invoice Date ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="InvoiceDate" class="form-label"></label>

        @if (Model.HasSource)
        {
            @* <input type="hidden" asp-for="InvoiceDate" /> *@

            <input asp-for="InvoiceDate"
                   type="date"
                    class="form-control"
                   readonly />
        }
        else
        {
            <input asp-for="InvoiceDate"
                   type="date"
                   class="form-control" />
        }

        
        <span asp-validation-for="InvoiceDate" class="text-danger"></span>
    </div>

    @* ================= InvoiceStatus ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="Status" class="form-label"></label>
        @* <select asp-for="Status"
                disabled="@Model.HasSource"
                asp-items="Html.GetEnumSelectList<InvoiceStatus>()"
                class="form-select">
        </select> *@
        <div class="form-control">
            <span class="badge @Model.Status.ToCssClass()">
                @Localizer[Model.Status.ToString()]
            </span>
        </div>
        
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

</div>

<partial name="Partials/Form/_InvoiceItemFormTable" model="Model" />

<partial name="Partials/Form/_AddInvoiceItemModal" model="Model" />

<partial name="Partials/Form/_InvoicePaymentFromTable" model="Model" />

<partial name="Partials/Form/_AddInvoicePaymentModal" model="Model" />

<partial name="Partials/Form/_InvoiceSummary" model="Model" />
