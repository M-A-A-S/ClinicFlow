@using ClinicFlow.Domain.DTOs.Invoice
@using System.Globalization
@using ClinicFlow.Domain.Enums
@model InvoiceDTO

@{
    bool isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="d-flex justify-content-end">
    <button type="button"
            id="open-add-item-modal-btn"
            class="btn btn-primary btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#invoiceItemModal">

        <i class="fa fa-plus me-1"></i>
        @Localizer["Add"] @Localizer["InvoiceItem"]

    </button>
</div>

<div class="table-responsive mt-4">

    <table class="table table-hover align-middle mb-0">

        <thead>

            <tr>

                <th>
                    @Localizer["ItemType"]
                </th>

                <th>
                    @Localizer["Description"]
                </th>

                <th>
                    @Localizer["Quantity"]
                </th>

                <th>
                    @Localizer["UnitPrice"]
                </th>

                <th>
                    @Localizer["Total"]
                </th>              

                <th class="text-center"
                    style="width:80px;">
                </th>

            </tr>

        </thead>


        <tbody id="items-container">

            @if (Model.Items != null && Model.Items.Any())
            {
                for (var i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];

                    <tr class="invoice-item-row"
                        data-item-id="@item.Id">

                        @* ================= Item Type ================= *@
                        <td>

                            

                            <input type="hidden"
                                   name="Items.Index"
                                   value="@i" />

                            <input type="hidden"
                                   class="item-id-input"
                                   name="Items[@i].Id"
                                   value="@item.Id" />

                            <input type="hidden"
                                   class="item-type-input"
                                   name="Items[@i].ItemType"
                                   value="@item.ItemType" />

                            <span>
                                @Localizer[item.ItemType.ToString()]
                            </span>

                        </td>


                        @* ================= Description ================= *@
                        <td>
                            <span>
                                @item.Description
                            </span>

                            <input type="hidden"
                                   class="item-description-input"
                                   name="Items[@i].Description"
                                   value="@item.Description" />
                        </td>


                        @* ================= Quantity ================= *@
                        <td>
                            <span>
                                @item.Quantity
                            </span>

                            <input type="hidden"
                                   class="item-quantity-input"
                                   name="Items[@i].Quantity"
                                   value="@item.Quantity" />
                        </td>


                        @* ================= UnitPrice ================= *@
                        <td>
                            <span>
                                @item.UnitPrice
                            </span>

                            <input type="hidden"
                                   class="item-unitPrice-input"
                                   name="Items[@i].UnitPrice"
                                   value="@item.UnitPrice" />
                        </td>


                        @* ================= Total ================= *@
                        <td>
                            <span>
                                @item.Total
                            </span>

                            <input type="hidden"
                                   class="item-total-input"
                                   name="Items[@i].Total"
                                   value="@item.Total" />
                        </td>



                        @* ================= Remove ================= *@
                        <td class="text-center">

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger remove-item"
                                    title="@Localizer["Remove"]">

                                <i class="fa fa-trash"></i>

                            </button>

                        </td>

                    </tr>
                        }
            }

        </tbody>

    </table>


    @* ================= Empty State ================= *@

    <div id="items-empty"
         class="text-center text-muted py-4 @(Model.Items != null && Model.Items.Any() ? "d-none" : "")">

        <i class="fa fa-notes-medical fa-2x mb-2"></i>

        <div>
            @Localizer["NoItemsFound"]
        </div>

    </div>

</div>