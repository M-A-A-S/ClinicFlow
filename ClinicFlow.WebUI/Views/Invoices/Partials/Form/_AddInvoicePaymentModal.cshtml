@using ClinicFlow.Domain.DTOs.Invoice
@using ClinicFlow.Domain.Entities
@using ClinicFlow.Domain.Enums

@model InvoiceDTO

<div class="modal fade"
     id="invoicePaymentModal"
     tabindex="-1"
     aria-labelledby="invoicePaymentModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            @* ================= Header ================= *@

            <div class="modal-header">

                <h5 class="modal-title"
                    id="invoicePaymentModalLabel">

                    <i class="fa fa-money-bill-wave me-2"></i>

                    @Localizer["Add"] @Localizer["InvoicePayment"]

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="@Localizer["Close"]">
                </button>

            </div>


            @* ================= Body ================= *@

            <div class="modal-body">

                <div class="row g-3">


                    @* ================= Payment Type ================= *@

                    <div class="col-md-6">

                        <label class="form-label">
                            @Localizer["Type"]
                        </label>

                        <select id="invoicePaymentType"
                                class="form-select">

                            <option value="">
                                @Localizer["Select"]
                            </option>

                            @foreach (var type
                                in Enum.GetValues<BondType>())
                            {
                                <option value="@type" 
                                    data-display-name="@Localizer[type.ToString()]">
                                    @Localizer[type.ToString()]
                                </option>
                            }

                        </select>

                    </div>


                    @* ================= Payment Method ================= *@

                    <div class="col-md-6">

                        <label class="form-label">
                            @Localizer["PaymentMethod"]
                        </label>

                        <select id="invoicePaymentMethod"
                                asp-items="ViewBag.PaymentMethods"
                                class="form-select">

                            <option value="">
                                @Localizer["Select"]
                            </option>

                        </select>

                    </div>


                    @* ================= Amount ================= *@

                    <div class="col-md-6">

                        <label class="form-label">
                            @Localizer["Amount"]
                        </label>

                        <input type="number"
                               id="invoicePaymentAmount"
                               class="form-control"
                               min="0.01"
                               step="0.01"
                               value="0" />

                    </div>


                    @* ================= Payment Date ================= *@

                    <div class="col-md-6">

                        <label class="form-label">
                            @Localizer["PaymentDate"]
                        </label>

                        <input type="date"
                               id="invoicePaymentDate"
                               class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />

                    </div>


                    @* ================= Reference Number ================= *@

                    <div class="col-12">

                        <label class="form-label">
                            @Localizer["ReferenceNumber"]
                        </label>

                        <input type="text"
                               id="invoicePaymentReferenceNumber"
                               class="form-control"
                               maxlength="100" />

                    </div>


                    @* ================= Notes ================= *@

                    <div class="col-12">

                        <label class="form-label">
                            @Localizer["Notes"]
                        </label>

                        <textarea id="invoicePaymentNotes"
                                  class="form-control"
                                  rows="3"></textarea>

                    </div>

                </div>

            </div>


            @* ================= Footer ================= *@

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    @Localizer["Cancel"]

                </button>

                        @* id="save-invoice-payment" *@
                <button type="button"
                        id="add-payment"
                        class="btn btn-primary">

                    <i class="fa fa-plus me-1"></i>

                    @Localizer["Add"] @Localizer["InvoicePayment"]

                </button>

            </div>

        </div>

    </div>

</div>