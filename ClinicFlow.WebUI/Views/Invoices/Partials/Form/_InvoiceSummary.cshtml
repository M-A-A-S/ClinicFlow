@using ClinicFlow.Domain.DTOs.Invoice
@model InvoiceDTO

<div class="d-flex justify-content-end mt-4">
    <div class="border rounded p-3" style="min-width: 320px;">

        <div class="d-flex justify-content-between mb-2">
            <span>@Localizer["Subtotal"]</span>
            <strong id="invoice-subtotal">0.00</strong>
        </div>

        <div class="d-flex justify-content-between mb-2">
            <span>@Localizer["DiscountAmount"]</span>
            <strong id="invoice-discount">0.00</strong>
        </div>

        <div class="d-flex justify-content-between mb-2">
            <span>@Localizer["TaxAmount"]</span>
            <strong id="invoice-tax">0.00</strong>
        </div>

        <hr />

        <div class="d-flex justify-content-between mb-2">
            <strong>@Localizer["GrandTotal"]</strong>
            <strong id="invoice-grand-total">0.00</strong>
        </div>

        <div class="d-flex justify-content-between mb-2">
            <span>@Localizer["PaidAmount"]</span>
            <strong id="invoice-paid-amount">0.00</strong>
        </div>

        <div class="d-flex justify-content-between">
            <strong>@Localizer["RemainingAmount"]</strong>
            <strong id="invoice-remaining-amount">0.00</strong>
        </div>

    </div>
</div>