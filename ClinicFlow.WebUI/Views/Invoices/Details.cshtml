    <div class="card-body">

        <partial name="Partials/Details/_InvoiceDetails" model="Model" />

    </div>

    <div class="card-footer">

        @* <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            @Localizer["Edit"]
        </a> *@

        

    </div>

</div>