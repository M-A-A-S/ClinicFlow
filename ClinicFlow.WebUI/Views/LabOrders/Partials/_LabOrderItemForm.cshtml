@using ClinicFlow.Domain.DTOs.LabOrder
@using System.Globalization
@using ClinicFlow.Domain.Enums
@model LabOrderDTO

@{
    bool isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-transparent border-bottom py-3">
        <h5 class="mb-0 fw-semibold">
            <i class="fa fa-notes-medical me-2"></i>
            @Localizer["Items"]
        </h5>
    </div>

    <div class="card-body">

        @* ================= Add Item ================= *@

        <div class="row g-3 align-items-end">

            @* ================= LabTest ================= *@
            <div class="col-sm-6 col-md-4">
                <label for="labTestId" class="form-label">
                    @Localizer["LabTest"]
                </label>

                <select id="labTestId"
                        class="form-select select2"
                        asp-items="ViewBag.LabTests">
                    <option value="">
                        @Localizer["Select"]
                    </option>
                </select>
            </div>


            @* ================= Status ================= *@
            <div class="col-sm-6 col-md-4">
                <label for="status" class="form-label">
                    @Localizer["Status"]
                </label>

                <select id="status"
                        asp-items="Html.GetEnumSelectList<LabStatus>()"
                        class="form-select">
                </select>
            </div>


            @* ================= Add ================= *@
            <div class="col-sm-6 col-md-2">

                <button type="button"
                        id="add-item"
                        class="btn btn-primary w-100">

                    <i class="fa fa-plus me-1"></i>
                    @Localizer["Add"]

                </button>

            </div>

        </div>


        @* ================= Items Table ================= *@

        <div class="table-responsive mt-4">

            <table class="table table-hover align-middle mb-0">

                <thead>

                    <tr>

                        <th>
                            @Localizer["LabTest"]
                        </th>

                        <th>
                            @Localizer["Status"]
                        </th>

                        <th class="text-center"
                            style="width:80px;">
                        </th>

                    </tr>

                </thead>


                <tbody id="items-container">

                    @if (Model.Items != null && Model.Items.Any())
                    {
                        for (var i = 0; i < Model.Items.Count; i++)
                        {
                            var item = Model.Items[i];

                            <tr class="lab-test-item-row"
                                data-item-id="@item.Id">

                                @* ================= LabTest ================= *@
                                <td>

                                    <span class="item-lab-test-name">
                                        @(isArabic ? 
                                            item?.LabTest?.NameEn : 
                                            item?.LabTest?.NameAr)
                                    </span>

                                    <input type="hidden"
                                           name="Items.Index"
                                           value="@i" />

                                    <input type="hidden"
                                           class="item-id-input"
                                           name="Items[@i].Id"
                                           value="@item.Id" />

                                    <input type="hidden"
                                           class="item-lab-test-id-input"
                                           name="Items[@i].LabTestId"
                                           value="@item.LabTestId" />

                                </td>


                                @* ================= Status ================= *@
                                <td>

                                    @* <span class="item-status">
                                        @item.Status
                                    </span> *@

                                    <span class="badge @item.Status.ToCssClass()">
                                        @Localizer[item.Status.ToString()]
                                    </span>

                                    <input type="hidden"
                                           class="item-status-input"
                                           name="Parameters[@i].Status"
                                           value="@item.Status" />

                                </td>



                                @* ================= Remove ================= *@
                                <td class="text-center">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger remove-item"
                                            title="@Localizer["Remove"]">

                                        <i class="fa fa-trash"></i>

                                    </button>

                                </td>

                            </tr>
                                        }
                    }

                </tbody>

            </table>


            @* ================= Empty State ================= *@

            <div id="items-empty"
                 class="text-center text-muted py-4 @(Model.Items != null && Model.Items.Any() ? "d-none" : "")">

                <i class="fa fa-notes-medical fa-2x mb-2"></i>

                <div>
                    @Localizer["NoItemsFound"]
                </div>

            </div>

        </div>

    </div>

</div>