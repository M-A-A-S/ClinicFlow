@using ClinicFlow.Domain.DTOs.LabOrder
@model LabOrderDTO

@{
    bool isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="card">
    <div class="card-header text-white">
            <strong>@Localizer["Items"]</strong>
    </div>

    <div class="card-body">

        @if (Model.Items?.Any() == true)
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Localizer["LabTest"]</th>
                            <th>@Localizer["Status"]</th>
                            <th class="text-center">@Localizer["Actions"]</th>
                        </tr>
                    </thead>

                    <tbody>
                            @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    @(Model.Items.IndexOf(item) + 1)
                                </td>

                                <td>
                                    @(isArabic 
                                        ? item?.LabTest?.NameAr ?? item?.LabTest?.NameEn ?? "-"
                                        : item?.LabTest?.NameEn ?? item?.LabTest?.NameAr ?? "-")
                                </td>

                                <td>
                                    <span class="badge @item.Status.ToCssClass()">
                                        @Localizer[item.Status.ToString()]
                                    </span>
                                </td>

                                <td class="text-center">
                            @if (item.Result == null)
                                    {
                                        <a asp-controller="LabResults"
                                           asp-action="Create"
                                           asp-route-labOrderItemId="@item.Id"
                                           class="btn btn-sm btn-primary">
                                            <i class="fa fa-plus me-1"></i>
                                            @Localizer["EnterResult"]
                                        </a>
                                    }
                                    else
                                    {
                                        @* <a asp-controller="LabResults"
                                           asp-action="Details"
                                           asp-route-id="@item.Result.Id"
                                           class="btn btn-sm btn-info">
                                            <i class="fa fa-eye me-1"></i>
                                            @Localizer["ViewResult"]
                                        </a> *@

                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-controller="LabResults"
                                               asp-action="Details"
                                               asp-route-id="@item.Result.Id"
                                               class="btn btn-info"
                                               title="@Localizer["ViewResult"]">
                                                <i class="fa fa-eye me-1"></i>
                                                @Localizer["ViewResult"]
                                            </a>

                                            <a asp-controller="LabResults"
                                               asp-action="Edit"
                                               asp-route-labOrderItemId="@item.Id"
                                               class="btn btn-warning"
                                               title="@Localizer["EditResult"]">
                                                <i class="fa fa-edit me-1"></i>
                                                @Localizer["EditResult"]
                                            </a>
                                        </div>
                                    }
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="fa fa-stethoscope fa-2x mb-2"></i>
                <div>@Localizer["NoItemsFound"]</div>
            </div>
        }

    </div>
</div>