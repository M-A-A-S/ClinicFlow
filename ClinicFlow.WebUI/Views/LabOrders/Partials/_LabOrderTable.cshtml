@using ClinicFlow.Domain.Enums
@using ClinicFlow.WebUI.ViewModels.Common
@using ClinicFlow.WebUI.ViewModels.LabOrder;
@model LabOrderIndexVM

@{
    var routes = Model.Filter.ToRouteDictionary();

    var isArabic = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";

    var columns = new List<TableColumnVM>
    {
        new TableColumnVM
        {
            Column = "PatientId",
            Title = Localizer["Patient"]
        },
        new TableColumnVM
        {
            Column = "OrderDate",
            Title = Localizer["OrderDate"]
        },
        // new TableColumnVM
        // {
        //     Column = "Invoice",
        //     Title = Localizer["Invoice"],
        //     IsSortable = false
        // },
        new TableColumnVM
        {
            Column = "InvoiceStatus",
            Title = Localizer["InvoiceStatus"],
            IsSortable = false
        },
        new TableColumnVM
        {
            Column = string.Empty,
            Title = Localizer["Actions"],
            IsSortable = false
        }
    };

}

@if (Model.PagedResult.Items == null || !Model.PagedResult.Items.Any())
{
    <div class="alert alert-info">
        @Localizer["NoRecordsFound"]
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    @foreach (var column in columns)
                    {
                        <th>
                            @if (column.IsSortable)
                            {
                                <partial name="Partials/_SortableHeader"
                                         model='new SortHeaderVM
                                         {
                                             Column = column.Column,
                                             Title = column.Title,
                                             Filter = Model.Filter,
                                             Routes = routes
                                         }' />
                                        }
                            else
                            {
                                @column.Title
                            }
                        </th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.PagedResult.Items)
                {
                    <tr>
                        <td>@(item.Patient?.FullName ?? "-")</td>

                        <td>@item.OrderDate.ToString("g")</td>

                        <td>
                            @if (!item.InvoiceId.HasValue)
                            {
                                <span class="badge bg-secondary">
                                    @Localizer["NoInvoice"]
                                </span>
                            }
                            else
                            {
                                <span class="badge @item?.Invoice?.Status.ToCssClass()">
                                    @Localizer[item?.Invoice?.Status.ToString() ?? ""]
                                </span>
                            }
                        </td>


                        <td>

                            <div class="d-flex gap-1 align-items-center">
                                @* Invoice Actions *@
                                @if (!item.InvoiceId.HasValue)
                                {
                                    <a asp-controller="Invoices"
                                       asp-action="Create"
                                       asp-route-labOrderId="@item.Id"
                                       class="btn btn-icon btn-outline-primary tooltip-btn"
                                       data-tooltip="@Localizer["CreateInvoice"]">
                                        <i class="fa fa-file-invoice"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Invoices"
                                       asp-action="Details"
                                       asp-route-id="@item.InvoiceId"
                                       class="btn btn-icon btn-outline-secondary tooltip-btn"
                                       data-tooltip="@Localizer["ViewInvoice"]">
                                        <i class="fa fa-receipt"></i>
                                    </a>
                                }

                                <partial name="Partials/_Actions"
                                         model='new ActionButtonsVM
                                         {
                                             Controller = "LabOrders",
                                              ShowDelete = !item.InvoiceId.HasValue,
                                              ShowEdit = !item.InvoiceId.HasValue,
                                             Id = item.Id
                                         }' />
                    </div>
                </td>

                    </tr>
                        }
            </tbody>
        </table>
    </div>
}
