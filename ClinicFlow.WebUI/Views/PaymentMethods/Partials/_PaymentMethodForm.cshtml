@using ClinicFlow.Domain.DTOs.PaymentMethod
@using ClinicFlow.Domain.Enums
@model PaymentMethodDTO


<div class="row g-3 mb-2">

    @* ================= NameEn ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="NameEn" class="form-label"></label>
        <input asp-for="NameEn" class="form-control" />
        <span asp-validation-for="NameEn" class="text-danger"></span>
    </div>

    @* ================= NameAr ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="NameAr" class="form-label"></label>
        <input asp-for="NameAr" class="form-control" />
        <span asp-validation-for="NameAr" class="text-danger"></span>
    </div>

    @* ================= Type ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="Type" class="form-label"></label>
        @* <select asp-for="Type"
                asp-items="Html.GetEnumSelectList<PaymentMethodType>()"
                class="form-select">
        </select> *@
        @if (Model.CanChangeType)
        {
            <select asp-for="Type"
                    class="form-select">

                <option value="">
                    @Localizer["Select"]
                </option>

                @foreach (var item in Enum.GetValues<PaymentMethodType>())
                {
                    var disableCash =
                    item == PaymentMethodType.Cash;


                    <option value="@((int)item)" disabled="@disableCash">
                        @Localizer[item.ToString()]
                    </option>
                }

            </select>
        }
        else
        {
            <input type="hidden" asp-for="Type" />

            <div class="form-control">
                @Localizer[Model.Type.ToString()]
            </div>
        }

        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    @* ================= IsActive ================= *@
    <div class="col-sm-6 col-md-4 d-flex align-items-end">
        <div class="form-check form-switch">
            <input asp-for="IsActive"
                   class="form-check-input"
                   type="checkbox" />

            <label asp-for="IsActive"
                   class="form-check-label"></label>

            <span asp-validation-for="IsActive"
                  class="text-danger"></span>
        </div>
    </div>

</div>
