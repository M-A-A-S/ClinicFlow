@using ClinicFlow.Domain.Enums
@using ClinicFlow.WebUI.ViewModels.PaymentMethod;
@model PaymentMethodIndexVM

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            @* ========================== Search ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.Search" class="form-label">@Localizer["Search"]</label>
                <input asp-for="Filter.Search"
                       class="form-control"
                       placeholder="@Localizer["Search"]" />
            </div>

            @* ========================== Type ========================== *@
            <div class="col-12 col-md-6 col-xl-3">
                <label asp-for="Filter.Type" class="form-label">@Localizer["Type"]</label>
                <select asp-for="Filter.Type"
                        id="typeId"
                        class="form-select select2"
                        asp-items="Html.GetEnumSelectList<PaymentMethodType>()">
                    <option value="">
                        @Localizer["Select"]
                    </option>
                </select>
            </div>

            @* ========================== Actions ========================== *@
            <div class="col-auto">
                <button type="submit"
                        class="btn btn-primary">
                    <i class="fa fa-search me-1"></i>
                    @Localizer["Search"]
                </button>
            </div>

            <div class="col-auto">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fa fa-times me-1"></i>
                    @Localizer["Clear"]
                </a>
            </div>

        </div>
    </div>
</form>