@using ClinicFlow.Domain.DTOs.Doctor
@model DoctorDTO


<div class="row g-3 mb-2">

    @* ================= FullName ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    @* ================= PhoneNumber ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    @* ================= Email ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    @* ================= ConsultationFee ================= *@
    <div class="col-sm-6 col-md-4">
        <label asp-for="ConsultationFee" class="form-label"></label>
        <input asp-for="ConsultationFee" type="number" class="form-control" />
        <span asp-validation-for="ConsultationFee" class="text-danger"></span>
    </div>

    @* ================= IsActive ================= *@
    <div class="col-sm-6 col-md-4 d-flex align-items-end">
        <div class="form-check form-switch">
            <input asp-for="IsActive"
                   class="form-check-input"
                   type="checkbox" />

            <label asp-for="IsActive"
                   class="form-check-label"></label>

            <span asp-validation-for="IsActive"
                  class="text-danger"></span>
        </div>
    </div>

</div>

<!-- ========================================================= -->
<!-- Specialties                                                 -->
<!-- ========================================================= -->

<div class="card mt-4 mb-2">

    <div class="card-header">

        <h5 class="mb-0">
            @Localizer["Specialties"]
        </h5>

    </div>


    <div class="card-body">

        <!-- Add Specialty -->
        <div class="row g-3 align-items-end">

            <div class="col-md-6 col-lg-5">

                <label class="form-label">
                    @Localizer["Specialty"]
                </label>

                <select id="specialtyId"
                        class="form-select"
                        asp-items="ViewBag.Specialties">

                    <option value="">
                        @Localizer["Select"]
                    </option>

                </select>

            </div>

            <div class="col-md-3 col-lg-2">

                <button type="button"
                        id="add-specialty"
                        class="btn btn-primary w-100">

                    <i class="fa fa-plus"></i>

                    @Localizer["Add"]

                </button>

            </div>

        </div>


        <!-- Specialty Table -->
        <div class="table-responsive mt-4">

            <table class="table">

                <thead>

                    <tr>

                        <th>
                            @Localizer["Specialty"]
                        </th>

                        <th style="width: 80px;">
                        </th>

                    </tr>

                </thead>


                <tbody id="specialties-container">

                    @* JavaScript adds rows here *@

                </tbody>

            </table>

        </div>

    </div>

</div>

